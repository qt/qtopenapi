include($QT_INSTALL_DOCS/global/qt-module-defaults.qdocconf)

project                 = QtOpenAPI
description             = Qt OpenAPI Reference Documentation
version                 = $QT_VERSION

qhp.projects            = QtOpenAPI

qhp.QtOpenAPI.file             = qtopenapi.qhp
qhp.QtOpenAPI.namespace        = org.qt-project.qtopenapi.$QT_VERSION_TAG
qhp.QtOpenAPI.virtualFolder    = qtopenapi
qhp.QtOpenAPI.indexTitle       = Qt OpenAPI
qhp.QtOpenAPI.indexRoot        =

qhp.QtOpenAPI.subprojects                       =  security cmake examples
qhp.QtOpenAPI.subprojects.examples.title        = Examples
qhp.QtOpenAPI.subprojects.examples.indexTitle   = Qt OpenAPI Examples
qhp.QtOpenAPI.subprojects.examples.selectors    = example
qhp.QtOpenAPI.subprojects.examples.sortPages    = true

qhp.QtOpenAPI.subprojects.cmake.title        = CMake: Qt OpenAPI
qhp.QtOpenAPI.subprojects.cmake.indexTitle   = CMake Commands in Qt6 OpenApi
qhp.QtOpenAPI.subprojects.cmake.selectors    = group:cmake-commands-qtopenapi
qhp.QtOpenAPI.subprojects.cmake.sortPages    = true

qhp.QtOpenAPI.subprojects.security.title        = Security considerations
qhp.QtOpenAPI.subprojects.security.indexTitle   = Qt OpenAPI Security Considerations
qhp.QtOpenAPI.subprojects.security.selectors    = none

exampledirs += \
                ../../../examples/openapi

examplesinstallpath = openapi
url.examples = "https://code.qt.io/cgit/qt/qtopenapi.git/tree/examples/\1?h=$QT_VER"

moduleheader =

sourcedirs += .. src/includes

depends += qtdoc qtcmake qtcore qtnetwork qthttpserver qtqml

navigation.landingpage = "Qt OpenAPI"

# Fail the documentation build if there are more warnings than the limit
warninglimit = 0
