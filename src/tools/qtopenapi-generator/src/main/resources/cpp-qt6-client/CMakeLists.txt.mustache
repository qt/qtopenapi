cmake_minimum_required(VERSION 3.16)

project({{{packageName}}} VERSION 0.1 LANGUAGES CXX)

set(CMAKE_AUTOMOC ON)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

find_package(Qt6 REQUIRED COMPONENTS Core Network {{^enableQmlCode}}Gui{{/enableQmlCode}}{{#enableQmlCode}}Qml{{/enableQmlCode}})
{{#contentCompression}}
find_package(ZLIB REQUIRED)
{{/contentCompression}}

include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

qt_add_library(${PROJECT_NAME}
{{#models}}
{{#model}}
    {{classname}}.h
{{/model}}
{{/models}}
{{#apiInfo}}
{{#apis}}
{{#operations}}
    {{classname}}.h
{{/operations}}
{{/apis}}
{{/apiInfo}}
    {{prefix}}BaseApi.h
    {{prefix}}Helpers.h
    {{prefix}}HttpRequest.h
    {{prefix}}Object.h
    {{prefix}}Enum.h
    {{prefix}}HttpFileElement.h
    {{prefix}}ServerConfiguration.h
    {{prefix}}ServerVariable.h
{{#models}}
{{#model}}
    {{classname}}.cpp
{{/model}}
{{/models}}
{{#apiInfo}}
{{#apis}}
{{#operations}}
    {{classname}}.cpp
{{/operations}}
{{/apis}}
{{/apiInfo}}
    {{prefix}}BaseApi.cpp
    {{prefix}}Helpers.cpp
    {{prefix}}HttpRequest.cpp
    {{prefix}}HttpFileElement.cpp
){{#enableQmlCode}}

qt_policy(SET QTP0001 NEW)
qt_policy(SET QTP0004 NEW)
qt_add_library(${PROJECT_NAME}_module)
qt_add_qml_module(${PROJECT_NAME}_module
    URI client
    VERSION 1.0
)
target_include_directories(${PROJECT_NAME}_module
    PRIVATE
        ${CMAKE_CURRENT_BINARY_DIR} # find autogenerated header
)
target_link_libraries(${PROJECT_NAME}_module
    PRIVATE
        ${PROJECT_NAME}
)
qt_generate_foreign_qml_types(${PROJECT_NAME} ${PROJECT_NAME}_module)
# Make sure the backing library is found on Windows next to the executable
set_target_properties(
    ${PROJECT_NAME}_module
    PROPERTIES
        RUNTIME_OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/..
        LIBRARY_OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/..
        ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/..
){{/enableQmlCode}}

target_include_directories(${PROJECT_NAME}
    PUBLIC
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
{{#contentCompression}}
    PRIVATE
        ${ZLIB_INCLUDE_DIRS}
{{/contentCompression}}
)

target_link_libraries(${PROJECT_NAME}
    PUBLIC
        Qt::Core
        Qt::Network{{^enableQmlCode}}
        Qt::Gui{{/enableQmlCode}}{{#enableQmlCode}}
        Qt::QmlIntegration{{/enableQmlCode}}
{{#contentCompression}}
    PRIVATE
        ZLIB::ZLIB
{{/contentCompression}}
)

configure_package_config_file(${CMAKE_CURRENT_SOURCE_DIR}/Config.cmake.in
    "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}Config.cmake"
    INSTALL_DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME}"
)

install(
    TARGETS ${PROJECT_NAME}
    EXPORT ${PROJECT_NAME}Targets
    LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
    ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
    RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
    INCLUDES DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/${PROJECT_NAME}"
)

install(
    FILES ${HEADER_FILES}
    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/${PROJECT_NAME}
)

install(
    FILES "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}Config.cmake"
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME}
)

install(
    EXPORT ${PROJECT_NAME}Targets
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME}
)
